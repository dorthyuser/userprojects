AWS_REGION=us-east-1
LOG_LEVEL=INFO
SCHEDULE_CRON=0 0 * * *

SQLSERVER_HOST=process.env.SQLSERVER_HOST
SQLSERVER_PORT=process.env.SQLSERVER_PORT
SQLSERVER_DATABASE=process.env.SQLSERVER_DATABASE
SQLSERVER_USERNAME=process.env.SQLSERVER_USERNAME
SQLSERVER_PASSWORD=process.env.SQLSERVER_PASSWORD

DB_HOST=hotel-booking.db.example.com
DB_PORT=5432
DB_NAME=hotel_booking
DB_USER=hotel_app
DB_PASSWORD=process.env.DB_PASSWORD
DB_SSL_MODE=require
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100
IDENTITY_HEADER_NAME=Idempotency-Key
