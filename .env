PORT=8080
NODE_ENV=production
AWS_REGION=us-east-1
AWS_SECRETS_MANAGER_NAME=travel-card-api/prod
AWS_KMS_KEY_ID=
LOG_LEVEL=info
CORS_ORIGIN=*
IDEMPOTENCY_WINDOW_SECONDS=86400
TOKENIZATION_ENABLED=true
FRAUD_DETECTION_ENABLED=true
AML_CONTROLS_ENABLED=true
PII_REDACTION_ENABLED=true
PCI_DSS_MODE=strict
