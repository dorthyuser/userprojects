<Project>
  <!-- Every project of the solution: nullable reference types, the package versions locked (packages.lock.json —
       a CI restore runs in locked mode) and NuGet's audit of every package, direct or brought in -->
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
  </PropertyGroup>
</Project>
