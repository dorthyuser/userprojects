{
  "connection": {
    "name": "travelcard-connection",
    "protocol": "HTTPS",
    "authMethod": "oauth2"
  },
  "auth": {
    "oauth2": {
      "clientId": "$AZURE-CLIENT-ID",
      "clientSecret": "$AZURE-CLIENT-SECRET",
      "tokenUrl": "$AZURE-TOKEN-URL",
      "grantType": "client_credentials",
      "authorizationUrl": null,
      "scopes": ["$AZURE-SCOPES"]
    }
  }
}
